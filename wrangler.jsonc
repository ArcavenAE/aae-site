// Static assets only, no Worker script. Deployed by .github/workflows/site.yml.
{
  "name": "aae-site",
  "compatibility_date": "2026-11-27",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  // The one hostname this Worker serves.
  "routes": [{ "pattern": "docs.darkatelier.org", "custom_domain": true }],
  "workers_dev": false,
  "send_metrics": false
}
